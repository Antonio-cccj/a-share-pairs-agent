# =============================================================================
# Environment configuration for a-share-pairs-agent
# Copy this file to `.env` and fill in your own credentials.
# DO NOT commit `.env` to git (it is already in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Data sources
# -----------------------------------------------------------------------------
# Tushare Pro token. Apply at https://tushare.pro (free, points >= 2000 needed
# for full A-share OHLCV access).  Leave empty to use the akshare fallback.
TUSHARE_TOKEN=

# Cache root for downloaded data.
DATA_CACHE_DIR=./data/cache

# Database URL (SQLite by default, switch to postgres+psycopg if using docker-compose).
DATABASE_URL=sqlite:///./data/edpt.sqlite

# -----------------------------------------------------------------------------
# LLM provider (pick ONE; the factory in core/llm/factory.py reads LLM_PROVIDER)
# Valid values: anthropic | openai | deepseek | zhipu | ollama | mock
# When set to `mock`, no API key is needed; rule-based classification is used.
# -----------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI / OpenAI-compatible (DeepSeek, Moonshot, DashScope Qwen, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek shortcut (uses the OpenAI client under the hood)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Zhipu GLM (https://open.bigmodel.cn)
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# Ollama (local; install at https://ollama.com)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# Embedding / RAG
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=announcements

# -----------------------------------------------------------------------------
# Backtest parameters
# -----------------------------------------------------------------------------
BACKTEST_COMMISSION_BPS=3
BACKTEST_STAMP_DUTY_BPS=10
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_START=2021-01-01
BACKTEST_END=2024-12-31

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
